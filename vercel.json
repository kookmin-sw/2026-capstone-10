{
  "builds": [
    {
      "src": "frontend_local_test/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend_local_test/dist/$1"
    }
  ],
  "functions": {
    "api/**/*.py": {
      "maxDuration": 300
    }
  }
}
